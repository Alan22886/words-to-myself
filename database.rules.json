{
  "rules": {
    ".read": false,
    ".write": false,
    "pages": {
      "$uid": {
        "current": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['v', 'iv', 'data'])",
          "v": { ".validate": "newData.val() === 1" },
          "iv": { ".validate": "newData.isString() && newData.val().length === 16" },
          "data": { ".validate": "newData.isString() && newData.val().length <= 2700000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
